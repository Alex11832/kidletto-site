// Control-panel Worker: serves the console (../vapi-control) and its API.
// Secrets are NEVER stored here — see README.md "Required Cloudflare variables".
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kidletto-vapi-control",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  // https://kidletto-vapi-control.<account-subdomain>.workers.dev/vapi-control/
  "workers_dev": true,
  // Preview URLs would be a second hostname; keep them off.
  "preview_urls": false,
  // Variables added in the Cloudflare dashboard (TEAM_DOMAIN, POLICY_AUD,
  // ALLOWED_EMAILS, VAPI_ASSISTANT_ID) survive `wrangler deploy`.
  "keep_vars": true,

  // www.vivpod.com/vapi-control/ — the console's own address once the
  // vivpod.com zone is active in Cloudflare (README §10, variant C). The
  // route is narrow: every other vivpod.com page still goes to Railway.
  // Uncomment only after the zone is active, or the deploy fails.
  // "routes": [{ "pattern": "www.vivpod.com/vapi-control*", "zone_name": "vivpod.com" }],

  "assets": {
    "directory": "../vapi-control",
    "binding": "ASSETS",
    // Every request (static files too) goes through the Worker's Access check.
    "run_worker_first": true
  },

  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "CallHub" }]
  },

  // Workers AI: operator dictation (speech -> text) and Russian -> English
  // translation of operator lines. Billed to this Cloudflare account; a
  // day's normal use fits in the free daily allowance.
  "ai": { "binding": "AI" },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CallHub"] }],

  "vars": {
    // Extra origins allowed to call the API cross-origin (exact match, no wildcards).
    "ALLOWED_ORIGINS": "https://kidletto.com, https://www.vivpod.com",

    // Cloudflare Access. Neither value is a secret: both appear in the public
    // login redirect. Several team names may be listed, comma separated — but
    // list only names that actually serve /cdn-cgi/access/certs, since every
    // entry is a trusted source of signing keys.
    "TEAM_DOMAIN": "https://kidletto.cloudflareaccess.com",
    // AUD tag of the Access application "kidletto-vapi-control - Cloudflare
    // Workers". Recreating that application issues a NEW tag and logins then
    // fail with "wrong audience" — read the fresh value from the `kid`
    // parameter of the login redirect and update it here.
    "POLICY_AUD": "9cf2a994daa261f6f0f33ae08823393a5691fb9a6030d21e38b8414d796ce66f",
    // Independent allowlist, enforced by the Worker on top of the Access policy.
    "ALLOWED_EMAILS": "geofakt@gmail.com",

    // Web Push (call alerts with no console tab open). The public half of the
    // VAPID key pair; the private half is the secret VAPID_PRIVATE_KEY. A new
    // pair invalidates every device's alert subscription (each device then
    // re-subscribes on its next visit).
    "VAPID_PUBLIC_KEY": "BFaBLwX5NMzio9Bh_ifzi7rnG4XhQlH7tubJ4afF5JJf2U237lNn_wGoEMveQTK5S1ndlIQCu4PKu1TSexeGQCo",
    // Contact shown to the push services (Google, Apple, Mozilla, Microsoft).
    "VAPID_SUBJECT": "https://kidletto.com"
  },

  // Structured logs from the code only. Automatic invocation logs are off:
  // they would store request headers (Access JWT / webhook credential).
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}
